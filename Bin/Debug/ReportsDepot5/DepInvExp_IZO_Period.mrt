        <Dictionary isRef="1" />
        <Name>Client</Name>
        <NameInSource>PrimeSoft</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select 0 as ID, '--ВСЕ--' as Name, 0 as nOrder 
union all
select ID, Name, 1 as nOrder from Client inner join (select distinct idClient from DepTrans where idDepDocType = 2) DC on Client.ID = DC.idClient 
where Type = 4 
order by nOrder, Name</SqlCommand>
