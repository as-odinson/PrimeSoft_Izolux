        <Name>w_TaskMaterComing</Name>
        <NameInSource>PrimeSoft</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy
select * from w_TaskMaterComing where DocDate &gt;= {sDateBeg} and DocDate &lt;= {sDateEnd} and idDepDocType = 2 and
	({idClient} = 0  or ({idClient} &lt;&gt; 0 and idClient = {idClient}))
order by MaterName</SqlCommand>
      </w_TaskMaterComing>
