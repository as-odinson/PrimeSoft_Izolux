    <DataSources isList="true" count="1">
      <qwe Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>qwe</Alias>
        <Columns isList="true" count="5">
          <value>Name,System.String</value>
          <value>NameShort,System.String</value>
          <value>DateGiveManufact,System.DateTime</value>
          <value>Area,System.Double</value>
          <value>ID,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <ConnectOnStart>False</ConnectOnStart>
        <Dictionary isRef="1" />
        <Name>qwe</Name>
        <NameInSource>PrimeSoft</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy;
select
	Client.ID,
	Client.Name,
	IsNull(Client.NameShort, '')      as NameShort,
	dbo.f_TruncDate(Task.{sDateType}) as DateGiveManufact,
	sum(Task.Area) as Area
from Client
	left join Task on Client.ID = Task.idClient
where
	Task.nState &amp; 2 = 2
	and dbo.f_TruncDate(Task.{sDateType}) &gt;= {sDateBeg} 
	and dbo.f_TruncDate(Task.{sDateType}) &lt;= {sDateEnd}
group by 
	Client.ID,
	Client.Name,
	Client.NameShort,
	dbo.f_TruncDate(Task.{sDateType})
</SqlCommand>
      </qwe>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
