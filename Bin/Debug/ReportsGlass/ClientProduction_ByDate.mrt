        <ButtonControl1 Ref="28" type="Stimulsoft.Report.Dialogs.StiButtonControl" isKey="true">
          <ClickEvent>sDateBeg = "'" + DateTimePickerControl1.Value.ToString("dd.MM.yyyy") + "'";
sDateEnd = "'" + DateTimePickerControl2.Value.ToString("dd.MM.yyyy") + "'";

if ( cbDateType.Text == "Приема" )
	sDateType = "Date";
else if ( cbDateType.Text == "Производства" )
	sDateType = "DateGiveManufact";
else if ( cbDateType.Text == "Произведено" )
	sDateType = "DateCompliteGP";
else
	sDateType = "DateComplite";

qwe.Connect();</ClickEvent>
