          <ClickEvent>sDateBeg = "'" + DateTimePickerControl1.Value.ToString("dd.MM.yyyy") + "'";
sDateEnd = "'" + DateTimePickerControl2.Value.ToString("dd.MM.yyyy") + "'";


f_SawTaskUE_Period_Detail.Connect();
f_SawTaskUE_Period_Operator.Connect();

/*

f_SawTaskUE_Period_Detail.ConnectOnStart = true;
f_SawTaskUE_Period_Detail.Disconnect();
f_SawTaskUE_Period_Detail.Connect();

f_SawTaskUE_Period_Operator.ConnectOnStart = true;
f_SawTaskUE_Period_Operator.Disconnect();
f_SawTaskUE_Period_Operator.Connect();
*/


try
{
DateTime selectedDate1 = DateTimePickerControl1.Value; 
string dateValue1 = selectedDate1.ToString("yyyy-MM-dd"); 

DateTime selectedDate2 = DateTimePickerControl2.Value; 
string dateValue2 = selectedDate2.ToString("yyyy-MM-dd"); 

  using (RegistryKey key = Registry.CurrentUser.CreateSubKey(@"Software\PrimeSoft\IzoGlass\Reports"))
  {
    if (key != null)
    {
      key.SetValue("DateBegUE", dateValue1);
      key.SetValue("DateEndUE", dateValue2);
      
      //MessageBox.Show("Даты записаны в реестр:\nНачало: " + dateValue1 + "\nКонец: " + dateValue2);
    }
  }
}
catch (Exception ex)
{
  MessageBox.Show("Ошибка записи в реестр: " + ex.Message);
}
