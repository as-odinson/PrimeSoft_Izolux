        <Dictionary isRef="1" />
        <Name>v_ManagerReport</Name>
        <NameInSource>PrimeSoft</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy
select * from v_ManagerReport where nState &amp; 2 = 2 and DateComplite &gt;= {sDateBeg} and DateComplite &lt;= {sDateEnd} and bremake = 0 {whereDepotSubDivision}</SqlCommand>
      </v_ManagerReport>
