          "Today": false,
          "MaxDate": "/Date(4102434000000+0300)/",
          "MinDate": "/Date(1262296800000+0200)/",
          "Value": "/Date(1759179600000+0300)/"
        },
        "4": {
          "Ident": "StiButtonControl",
          "Name": "ButtonControl1",
          "Guid": "9a6fa5b4302b4a6698327c6779cd220e",
          "ClientRectangle": "16,40,80,32",
          "ClickEvent": {
            "Script": "sDateBeg = \"'\" + DateTimePickerControl1.Value.ToString(\"dd.MM.yyyy\") + \"'\";\r\nsDateEnd = \"'\" + DateTimePickerControl2.Value.ToString(\"dd.MM.yyyy\") + \"'\";\r\n\r\n\r\n//f_SawTaskUE_Period_Detail.Connect();\r\n//f_SawTaskUE_Period_Operator.Connect();\r\n\r\n/**/\r\n\r\nf_SawTaskUE_Period_Detail.ConnectOnStart = true;\r\nf_SawTaskUE_Period_Detail.Disconnect();\r\nf_SawTaskUE_Period_Detail.Connect();\r\n\r\nf_SawTaskUE_Period_Operator.ConnectOnStart = true;\r\nf_SawTaskUE_Period_Operator.Disconnect();\r\nf_SawTaskUE_Period_Operator.Connect();\r\n/**/\r\n\r\n\r\ntry\r\n{\r\nDateTime selectedDate1 = DateTimePickerControl1.Value; \r\nstring dateValue1 = selectedDate1.ToString(\"yyyy-MM-dd\"); \r\n\r\nDateTime selectedDate2 = DateTimePickerControl2.Value; \r\nstring dateValue2 = selectedDate2.ToString(\"yyyy-MM-dd\"); \r\n\r\n  using (RegistryKey key = Registry.CurrentUser.CreateSubKey(@\"Software\\PrimeSoft\\IzoGlass\\Reports\"))\r\n  {\r\n    if (key != null)\r\n    {\r\n      key.SetValue(\"DateBegUE\", dateValue1);\r\n      key.SetValue(\"DateEndUE\", dateValue2);\r\n      \r\n      //MessageBox.Show(\"Даты записаны в реестр:\\nНачало: \" + dateValue1 + \"\\nКонец: \" + dateValue2);\r\n    }\r\n  }\r\n}\r\ncatch (Exception ex)\r\n{\r\n  MessageBox.Show(\"Ошибка записи в реестр: \" + ex.Message);\r\n}\r\n"
          },
          "Size": {
            "Width": 80,
            "Height": 32
          },
          "Location": {
            "X": "16",
            "Y": "40"
          },
          "Default": true,
          "DialogResult": "OK",
          "Text": "Готово"
        },
        "5": {
          "Ident": "StiButtonControl",
          "Name": "ButtonControl2",
          "Guid": "7705b94568644baf9b95405ada4e0729",
          "ClientRectangle": "152,40,80,32",
          "Size": {
            "Width": 80,
            "Height": 32
          },
          "Location": {
            "X": "152",
            "Y": "40"
          },
          "DialogResult": "Cancel",
          "Cancel": true,
          "Text": "Отмена"
        }
      },
      "LoadFormEvent": {
        "Script": "try\r\n{\r\nusing (RegistryKey key = Registry.CurrentUser.OpenSubKey(@\"Software\\PrimeSoft\\IzoGlass\\Reports\"))\r\n  {\r\n    if ( key != null )\r\n    {\r\nobject value1 = key.GetValue(\"DateBegUE\");\r\n      if ( value1 != null )\r\n        DateTimePickerControl1.Value = DateTime.Parse(value1.ToString());\r\n      else\r\n        DateTimePickerControl1.Value = DateTime.Now;\r\n\r\nobject value2 = key.GetValue(\"DateEndUE\");\r\n      if ( value2 != null )\r\n        DateTimePickerControl2.Value = DateTime.Parse(value2.ToString());\r\n      else\r\n        DateTimePickerControl2.Value = DateTime.Now;\r\n    }\r\n    else\r\n    {\r\n      DateTimePickerControl1.Value = DateTime.Now;\r\n      DateTimePickerControl2.Value = DateTime.Now;\r\n    }\r\n  }\r\n}\r\ncatch (Exception ex)\r\n{\r\n  DateTimePickerControl1.Value = DateTime.Now;\r\n  DateTimePickerControl2.Value = DateTime.Now;\r\n  MessageBox.Show(\"Ошибка чтения: \" + ex.Message);\r\n}"
      },
      "Size": {
        "Width": 256,
        "Height": 104
      },
      "Location": {
        "X": "0",
        "Y": "0"
      },
      "Text": "Временой интервал"
    }
