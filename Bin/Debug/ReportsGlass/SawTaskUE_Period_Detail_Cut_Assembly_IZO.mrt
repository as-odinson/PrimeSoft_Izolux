        "3": {
          "Ident": "StiDateTimePickerControl",
          "Name": "DateTimePickerControl2",
          "Guid": "411ed7e56ffa4b7fb1c1bbd71a77ed38",
          "ClientRectangle": "160,8,80,20",
          "Size": {
            "Width": 80,
