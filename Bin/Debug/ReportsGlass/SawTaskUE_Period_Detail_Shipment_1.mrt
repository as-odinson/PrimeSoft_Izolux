            "Script": "sDateBeg = \"'\" + DateTimePickerControl1.Value.ToString(\"dd.MM.yyyy\") + \"'\";\r\nsDateEnd = \"'\" + DateTimePickerControl2.Value.ToString(\"dd.MM.yyyy\") + \"'\";\r\n\r\n\r\nf_SawTaskUE_Period_Detail.Connect();\r\nf_SawTaskUE_Period_Operator.Connect();\r\n\r\n/*\r\n\r\nf_SawTaskUE_Period_Detail.ConnectOnStart = true;\r\nf_SawTaskUE_Period_Detail.Disconnect();\r\nf_SawTaskUE_Period_Detail.Connect();\r\n\r\nf_SawTaskUE_Period_Operator.ConnectOnStart = true;\r\nf_SawTaskUE_Period_Operator.Disconnect();\r\nf_SawTaskUE_Period_Operator.Connect();\r\n*/\r\n\r\n\r\ntry\r\n{\r\nDateTime selectedDate1 = DateTimePickerControl1.Value; \r\nstring dateValue1 = selectedDate1.ToString(\"yyyy-MM-dd\"); \r\n\r\nDateTime selectedDate2 = DateTimePickerControl2.Value; \r\nstring dateValue2 = selectedDate2.ToString(\"yyyy-MM-dd\"); \r\n\r\n  using (RegistryKey key = Registry.CurrentUser.CreateSubKey(@\"Software\\PrimeSoft\\IzoGlass\\Reports\"))\r\n  {\r\n    if (key != null)\r\n    {\r\n      key.SetValue(\"DateBegUE\", dateValue1);\r\n      key.SetValue(\"DateEndUE\", dateValue2);\r\n      \r\n      //MessageBox.Show(\"Даты записаны в реестр:\\nНачало: \" + dateValue1 + \"\\nКонец: \" + dateValue2);\r\n    }\r\n  }\r\n}\r\ncatch (Exception ex)\r\n{\r\n  MessageBox.Show(\"Ошибка записи в реестр: \" + ex.Message);\r\n}\r\n"
