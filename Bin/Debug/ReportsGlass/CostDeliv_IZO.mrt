    <DataSources isList="true" count="1">
      <DeliveryCost Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DeliveryCost</Alias>
        <Columns isList="true" count="7">
          <value>ID,System.Int32</value>
          <value>AccountNum,System.String</value>
          <value>DateDelivery,System.DateTime</value>
          <value>ClientName,System.String</value>
          <value>AddressDelivery,System.String</value>
          <value>CommentaryDeliv,System.String</value>
          <value>PriceDelivery,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <ConnectOnStart>False</ConnectOnStart>
        <Dictionary isRef="1" />
        <Name>DeliveryCost</Name>
        <NameInSource>baba</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy;
	select
	T.ID,
	T.AccountNum,
	T.DateDelivery,
	C.Name as ClientName,
	T.AddressDelivery,
	T.CommentaryDeliv,
	T.PriceDelivery
	from Task T
left join Client C on C.ID = T.idClient
where T.DateDelivery &gt;= {sDateBeg}
  and T.DateDelivery &lt;= {sDateEnd}
  and isnull(T.PriceDelivery, 0) &lt;&gt; 0
order by T.DateDelivery, T.AccountNum</SqlCommand>
      </DeliveryCost>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="4">
      <value>,sDateBeg,sDateBeg,System.String,_x0027_01.01.2010_x0027_,False,False</value>
      <value>,sDateEnd,sDateEnd,System.String,_x0027_01.01.2010_x0027_,False,False</value>
      <value>,sDepotSubDivision,sDepotSubDivision,System.String,,False,False</value>
      <value>,whereDepotSubDivision,whereDepotSubDivision,System.String,,False,False</value>
    </Variables>
  </Dictionary>
