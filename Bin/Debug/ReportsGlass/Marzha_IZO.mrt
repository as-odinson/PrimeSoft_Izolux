        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy
select * from v_ManagerReport 
where DateComplite &gt;= {sDateBeg} and DateComplite &lt;= {sDateEnd} 
and nState &amp; 8 = 8 -- Только отгруженные заказы</SqlCommand>
      </v_ManagerReport>
