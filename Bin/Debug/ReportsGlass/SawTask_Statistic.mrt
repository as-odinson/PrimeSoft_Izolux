  <ReportVersion>2013.1.1600</ReportVersion>
  <Script>using System;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class Report : Stimulsoft.Report.StiReport
    {
        public Report()        {
            this.InitializeComponent();
        }
		
		string GetFieldFirst(string s)
		{
			if (string.IsNullOrEmpty(s))
				return "";

			string[] clients = s.Split(new string[] { "&gt;&gt;" }, StringSplitOptions.None);

			System.Text.StringBuilder result = new System.Text.StringBuilder();

			foreach (string client in clients)
			{
				int p1 = client.LastIndexOf('(');
				int p2 = client.LastIndexOf(')');

				string name = client;
				string orders = "";

				if (p1 &gt;= 0 &amp;&amp; p2 &gt; p1)
				{
					name = client.Substring(0, p1);
					orders = client.Substring(p1 + 1, p2 - p1 - 1);
				}

				result.Append(name);
				result.Append("&lt;br /&gt;");

				int orderCount = orders.Split(',').Length;

				for (int i = 0; i &lt; orderCount; i++)
					result.Append("&lt;br /&gt;");
			}

			string resultText = result.ToString();

			if (resultText.EndsWith("&lt;br /&gt;"))
				resultText = resultText.Substring(0, resultText.Length - 6);

			return resultText;
		}
		
		string GetFieldSecond(string s)
		{
			if (string.IsNullOrEmpty(s))
				return "";

			string[] clients = s.Split(new string[] { "&gt;&gt;" }, StringSplitOptions.None);

			System.Text.StringBuilder result = new System.Text.StringBuilder();

			foreach (string client in clients)
			{
				int p1 = client.LastIndexOf('(');
				int p2 = client.LastIndexOf(')');

				if (p1 &gt;= 0 &amp;&amp; p2 &gt; p1)
				{
					string orders = client.Substring(p1 + 1, p2 - p1 - 1);

					string[] arr = orders.Split(',');

					foreach (string order in arr)
						result.Append(order.Trim() + "&lt;br /&gt;");
				}

				result.Append("&lt;br /&gt;");
			}

			string resultText = result.ToString();

			if (resultText.EndsWith("&lt;br /&gt;"))
				resultText = resultText.Substring(0, resultText.Length - 6);

			return resultText;
		}

        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}
</Script>
