    <DataSources isList="true" count="1">
      <GlassWaste Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>GlassWaste</Alias>
        <Columns isList="true" count="7">
          <value>idProduct,System.Int32</value>
          <value>ProductName,System.String</value>
          <value>ProductType,System.Int32</value>
          <value>AvgWastePct_Schelkovo,System.Decimal</value>
          <value>AvgWastePct_Stupino,System.Decimal</value>
          <value>SawTaskCount_Schelkovo,System.Int32</value>
          <value>SawTaskCount_Stupino,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <ConnectOnStart>False</ConnectOnStart>
        <Dictionary isRef="1" />
        <Name>GlassWaste</Name>
        <NameInSource>PrimeSoft</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy
	select
		P.ID   as idProduct,
		P.Name as ProductName,
		P.Type as ProductType,
		cast
		(
		avg
		(
		case when V.DepotSubDivisionName = 'Щелково'
        then convert(decimal(18, 4), V.WastePct)
        else null
        end
      ) as decimal(18, 2)
    ) as AvgWastePct_Schelkovo,

    cast
    (
      avg
      (
        case when V.DepotSubDivisionName = 'Ступино'
          then convert(decimal(18, 4), V.WastePct)
          else null
        end
      ) as decimal(18, 2)
    ) as AvgWastePct_Stupino,

    sum
    (
      case when V.DepotSubDivisionName = 'Щелково'
        then 1
        else 0
      end
    ) as SawTaskCount_Schelkovo,

    sum
    (
     case when V.DepotSubDivisionName = 'Ступино'
       then 1
       else 0
     end
    ) as SawTaskCount_Stupino

from Product P
left join dbo.v_Report_GlassWasteBySawTask V on V.idProduct = P.ID
                                         and V.SawTaskDate &gt;= {sDateBeg}
                                         and V.SawTaskDate &lt; dateadd(day, 1, {sDateEnd})

where P.Type in (5, 105)

group by
    P.ID,
    P.Name,
    P.Type

order by
    P.Type desc,
    P.Name
</SqlCommand>
      </GlassWaste>
    </DataSources>
