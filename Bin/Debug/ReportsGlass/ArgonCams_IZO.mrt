    <DataSources isList="true" count="1">
      <argon Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>argon</Alias>
        <Columns isList="true" count="6">
          <value>idTask,System.Int32</value>
          <value>Date,System.DateTime</value>
          <value>AccountNum,System.String</value>
          <value>Name,System.String</value>
          <value>AdjustedCount,System.Int32</value>
          <value>AssemblyLineName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <ConnectOnStart>False</ConnectOnStart>
        <Dictionary isRef="1" />
        <Name>argon</Name>
        <NameInSource>PrimeSoft</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>set dateformat dmy;

;with PD as
(
select
	T.ID as idTask,
	T.Date,
	T.DateComplite,
	T.AccountNum,
	C.Name,
	P.ID as idProject,
	sum(P.nCount *
	case
                when P.bIsArgon1 = 1 and P.bIsArgon2 = 1 then 2
                when P.bIsArgon1 = 1 or P.bIsArgon2 = 1 then 1
                else 0
            end) as AdjustedCount
    from Task T
    left join Project P on P.idTask = T.ID
    left join Client C on C.ID = T.idClient
    where P.bIsArgon1 = 1 or P.bIsArgon2 = 1
    group by
        T.ID, T.Date, T.DateComplite,
        T.AccountNum, C.Name, P.ID
),
ProjectAssembly as
(
select distinct
	GD.idProject,
	STM.idAssemblyLine
	from SawTaskMain STM
    inner join GlassDetails GD on GD.idSawTaskMain = STM.ID
)
select
	PD.idTask,
	PD.Date,
	PD.AccountNum,
	PD.Name,
	sum(PD.AdjustedCount) as AdjustedCount,
	AL.Name as AssemblyLineName
	from PD
	inner join ProjectAssembly PA on PA.idProject = PD.idProject
left join AssemblyLine AL on AL.ID = PA.idAssemblyLine
where PD.DateComplite &gt;= {sDateBeg}
  and PD.DateComplite &lt;= {sDateEnd}
group by
    PD.idTask,
    PD.Date,
    PD.AccountNum,
    PD.Name,
    AL.Name;</SqlCommand>
      </argon>
    </DataSources>
