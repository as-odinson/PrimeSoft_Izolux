              <HorAlignment>Center</HorAlignment>
              <Margins>0,0,0,0</Margins>
              <Name>Text35</Name>
              <Page isRef="5" />
              <Parent isRef="21" />
              <Text>{v_TTN.ProductionName}</Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>HotkeyPrefix=None, LineLimit=False, RightToLeft=False, Trimming=None, WordWrap=True, Angle=0, FirstTabOffset=40, DistanceBetweenTabs=20,</TextOptions>
              <Type>Expression</Type>
              <VertAlignment>Center</VertAlignment>
            </Text35>
            <Text36 Ref="44" type="Text" isKey="true">
              <BeforePrintEvent>double  NUM = v_TTN.nCount; //поле или переменная которую будем делать строкой
string  RUB,
	STRRUB  = "",
    		UNITRUB = "";

if ( NUM.ToString().Length &gt; 0 )
{ 
	RUB = NUM.ToString();

	if ( RUB != "0" )
	{

		string	UNITNAME	 = "",
		UNITNAME_1   = "",
		UNITNAME_234 = "";
		int nSIGN;
		int x = (RUB.Length - 1)/3; 
		
		switch ( RUB.Substring(RUB.Length - 1, 1) )
		{
			case "0":case "5":case "6":case "7":case "8":case "9":
				UNITRUB = "грузовых мест ";
				break;
			case "1":
				UNITRUB = "грузовое место ";
				break;
			case "2":case "3":case "4":
				UNITRUB = "грузовых места ";
				break;
		}	
		
		for ( int i = 0; i &lt;= x; i++ )
		{
			switch ( i )
			{
				case 0:
					UNITNAME 	 = "";
					UNITNAME_1   = "";
					UNITNAME_234 = "";
					break;
				case 1:
					UNITNAME     = "тысяч ";
					UNITNAME_1   = "тысяча ";
					UNITNAME_234 = "тысячи ";
					break;
				case 2:
					UNITNAME     = "миллионов ";
					UNITNAME_1   = "миллион ";
					UNITNAME_234 = "миллиона ";
					break;
				case 3:
					UNITNAME 	 = "миллиардов ";
					UNITNAME_1   = "миллиард ";
					UNITNAME_234 = "миллиарда ";
					break;
				case 4:
					UNITNAME 	 = "триллионов ";
					UNITNAME_1   = "триллион ";
					UNITNAME_234 = "триллиона ";
					break;
			}

			string 	UNIT    	 = "",
			TEN	    	 = "",
			HUNDRED      = "";
			
			for ( nSIGN = 1; nSIGN &lt;= (RUB.Length - i*3); nSIGN++ )
			{
				switch ( nSIGN )
				{
					case 1:
						if ( (RUB.Length - x*3) &gt; 1 &amp;&amp; RUB.Substring(RUB.Length - nSIGN - 1 - i*3,1) == "1")
							break;
						switch ( RUB.Substring(RUB.Length - nSIGN - i*3, 1) )
						{
							case "0":
								UNIT = ((i == x ? UNITNAME : "") );
								break;
							case "1":
								UNIT = "одно "  + UNITNAME_1;
								break;
							case "2":
								UNIT = "два "   + UNITNAME_234;
								break;
							case "3":
								UNIT = "три "    	+ UNITNAME_234;
								break;
							case "4":
								UNIT = "четыре " 	+ UNITNAME_234;
								break;
							case "5":
								UNIT = "пять "   	+ UNITNAME;
								break;
							case "6":
								UNIT = "шесть "  	+ UNITNAME;
								break;
							case "7":
								UNIT = "семь "   	+ UNITNAME;
								break;
							case "8":
								UNIT = "восемь " 	+ UNITNAME;
								break;
							case "9":
								UNIT = "девять " 	+ UNITNAME;
								break;
							default:
								UNIT = "";
								break;
						}
						break;
					case 2:
						switch ( RUB.Substring(RUB.Length - nSIGN - i*3, 2) )
						{
							case "10":
								TEN = "десять "       + UNITNAME;UNIT = "";
								break;
							case "11":
								TEN = "одинадцать "   + UNITNAME;UNIT = "";
								break;
							case "12":
								TEN = "двенадцать "   + UNITNAME;UNIT = "";
								break;
							case "13":
								TEN = "тринадцать "   + UNITNAME;UNIT = "";
								break;
							case "14":
								TEN = "четырнадцать " + UNITNAME;UNIT = "";
								break;
							case "15":
								TEN = "пятнадцать "   + UNITNAME;UNIT = "";
								break;
							case "16":
								TEN = "шестнадцать "  + UNITNAME;UNIT = "";
								break;
							case "17":
								TEN = "семнадцать "   + UNITNAME;UNIT = "";
								break;
							case "18":
								TEN = "восемнадцать " + UNITNAME;UNIT = "";
								break;
							case "19":
								TEN = "девятнадцать " + UNITNAME;UNIT = "";
								break;
							default:
								TEN = "";
								break;
						}
						switch ( RUB.Substring(RUB.Length - nSIGN - i*3, 1) )
						{
							case "0":
								TEN = ((i == x ? UNITNAME : "") );
								break;
							case "1":
								break;	
							case "2":
								TEN = "двадцать ";
								break;
							case "3":
								TEN = "тридцать ";
								break;
							case "4":
								TEN = "сорок ";
								break;
							case "5":
								TEN = "пятьдесят ";
								break;
							case "6":
								TEN = "шестьдесят ";
								break;
							case "7":
								TEN = "семьдесят ";
								break;
							case "8":
								TEN = "восемдесят ";
								break;
							case "9":
								TEN = "девяносто ";
								break;
						}
						break;
					case 3:
						switch ( RUB.Substring(RUB.Length - nSIGN - i*3, 1) )
						{
							case "1":
								HUNDRED = "сто ";
								break;
							case "2":
								HUNDRED = "двести ";
								break;
							case "3":
								HUNDRED = "триста ";
								break;
							case "4":
								HUNDRED = "четыреста ";
								break;
							case "5":
								HUNDRED = "пятьсот ";
								break;
							case "6":
								HUNDRED = "шестьсот ";
								break;
							case "7":
								HUNDRED = "семьсот ";
								break;
							case "8":
								HUNDRED = "восемсот ";
								break;
							case "9":
								HUNDRED = "девятьсот ";
								break;
							default:
								HUNDRED = "";
								break;
						}
						break;
				}
			}
			STRRUB = HUNDRED + TEN + UNIT + STRRUB;
		}
	}
	else
		STRRUB = "Ноль ";

	StrCountPos = " (" + STRRUB + ") " + UNITRUB; //Передаем строку в переменную для вывода в отчете
}</BeforePrintEvent>
