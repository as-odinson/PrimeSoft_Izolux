DateTime selectedDate2 = DateTimePickerControl2.Value; 
string dateValue2 = selectedDate2.ToString("yyyy-MM-dd"); 

  using (RegistryKey key = Registry.CurrentUser.CreateSubKey(@"Software\PrimeSoft\IzoGlass\Reports"))
