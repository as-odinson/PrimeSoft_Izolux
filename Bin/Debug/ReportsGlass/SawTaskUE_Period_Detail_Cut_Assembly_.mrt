      <LoadFormEvent>try
{
using (RegistryKey key = Registry.CurrentUser.OpenSubKey(@"Software\PrimeSoft\IzoGlass\Reports"))
  {
    if ( key != null )
    {
object value1 = key.GetValue("DateBegUE");
      if ( value1 != null )
        DateTimePickerControl1.Value = DateTime.Parse(value1.ToString());
      else
        DateTimePickerControl1.Value = DateTime.Now;

object value2 = key.GetValue("DateEndUE");
      if ( value2 != null )
        DateTimePickerControl2.Value = DateTime.Parse(value2.ToString());
      else
        DateTimePickerControl2.Value = DateTime.Now;
    }
    else
    {
      DateTimePickerControl1.Value = DateTime.Now;
      DateTimePickerControl2.Value = DateTime.Now;
    }
  }
}
catch (Exception ex)
{
  DateTimePickerControl1.Value = DateTime.Now;
  DateTimePickerControl2.Value = DateTime.Now;
  MessageBox.Show("Ошибка чтения: " + ex.Message);
}</LoadFormEvent>
